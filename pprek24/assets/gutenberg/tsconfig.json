{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./assets/js/gutenberg",
    "types": ["react"],
    "paths": {
      "react": ["../../node_modules/@types/react"]
    }
  },
  "include": [
    "./**/*",
    "./**/*.tsx"
  ]
}