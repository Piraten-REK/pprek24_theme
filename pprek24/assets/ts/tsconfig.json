{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES5", "ES2015", "ES2016", "ESNext"],
    "moduleResolution": "node",
    "outDir": "../js",
    "removeComments": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["svelte"],
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*", "./**/*.ts", "../svelte/**/*", "../svelte/**/*.svelte"],
  "extends": "@tsconfig/svelte/tsconfig.json"
}
