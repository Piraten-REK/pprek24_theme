{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "moduleResolution": "node",
    "outDir": "./assets/js/gutenberg",
    "removeComments": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "esnext"
  },
  "include": ["assets/ts/gutenberg/**/*"]
}