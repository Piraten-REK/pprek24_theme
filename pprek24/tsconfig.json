{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES5", "ES2015", "ES2016", "ESNext"],
    "moduleResolution": "node",
    "outDir": "./assets/js",
    "removeComments": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["assets/ts/**/*", "assets/ts/**/*.ts", "assets/svelte/**/*", "assets/svelte/**/*.svelte"],
  "extends": "@tsconfig/svelte/tsconfig.json"
}
